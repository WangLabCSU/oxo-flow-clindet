# oxo-flow port of the clindet WGS run type (zyllifeworld/clindet @ 582a9131,
# workflow/WGS + wrapper/wgs.smk).
#
# WGS shares the mapping/dedup/recal chain, the vcf_norm/vcf2maf/merge/flag/
# report tail and the CNV module with WES (same results/... tree upstream).
# The WGS deltas live in rules/91_wgs_callers.oxoflow (callers without
# exome restrictions: no --intervals/--callRegions/--exome, Manta emits
# somaticSV, germline Strelka takes both bams, vardict regions from the
# .fai) and rules/90_wgs.oxoflow (CollectWgsMetrics/CollectInsertSizeMetrics
# + delly/svaba SV).
#
# Upstream has NO WGS mini-test config (the shipped mini_test_data covers
# dna + rna only), so this workflow's fixture run is a pseudo-WGS smoke
# test: the chr21 fixture BAMs are run whole-genome over the 900 bp chr21
# reference with the mini annotation files standing in for the WGS
# resources (WGS_PON empty, gnomad germline resource, Mills dbsnp_indel) —
# documented honestly in the Fidelity table.

[workflow]
name = "oxo-flow-clindet-wgs"
version = "1.0.0"
description = "Clinical WGS pipeline ported from zyllifeworld/clindet (workflow/WGS paired path + delly/svaba SV)"
author = "oxo-flow-community"
pairs_file = "samplesheet.csv"
format_version = "1.0"

# ---------------------------------------------------------------------------
# Project / genome (upstream: config['project'] + config['genome_version'])
# ---------------------------------------------------------------------------
[config]
output_dir = "mini_test_wgs"
genome_version = "hg38_chr21"
# run-type switch: gates off the WES-only rules (CollectHsMetrics etc.)
# shared from 00_common; WGS runs CollectWgsMetrics (rules/90_wgs.oxoflow)
wgs_mode = true

# Reads (upstream samplesheet columns Tumor_R1_file_path / Normal_R1_file_path ...)
tumor_fastq_r1 = "test/fixtures/reads/mini-T_R1.fq.gz"
tumor_fastq_r2 = "test/fixtures/reads/mini-T_R2.fq.gz"
normal_fastq_r1 = "test/fixtures/reads/mini-NC_R1.fq.gz"
normal_fastq_r2 = "test/fixtures/reads/mini-NC_R2.fq.gz"

# Resources (upstream: config['resources'][genome_version])
reference = "test/fixtures/refs/sequence/Homo_sapiens_assembly38_chr21.fasta"
reference_dict = "test/fixtures/refs/sequence/Homo_sapiens_assembly38_chr21.dict"
target_bed = "test/fixtures/bed/exome_target_hg38_chr21.bed"
wes_pon = ""
# WGS_PON is empty in the mini config (upstream hg38_chr21 has none)
wgs_pon = ""
mutect2_vcf = "test/fixtures/refs/annotations/gnomAD.r2.1.1.GRCh38.PASS.AC.AF.only_chr21.vcf.gz"
mutect2_germline_vcf = "test/fixtures/refs/annotations/gnomAD.r2.1.1.GRCh38.PASS.AC.AF.only_chr21.vcf.gz"
dbsnp = "test/fixtures/refs/annotations/dbsnp_146.hg38_chr21.vcf.gz"
dbsnp_indel = "test/fixtures/refs/annotations/Mills_and_1000G_gold_standard.indels.hg38_chr21.vcf.gz"
dbsnp_gz = "test/fixtures/refs/annotations/dbsnp_146.hg38_chr21.vcf.gz"
flag_config_dir = "test/fixtures/flag"

# BQSR (upstream recal_BQSR, mini-test default False)
recal_bqsr = false
known_sites1 = "test/fixtures/refs/annotations/known_sites1.mini.vcf.gz"
known_sites2 = "test/fixtures/refs/annotations/known_sites2.mini.vcf.gz"

# Caller lists (upstream run_params)
somatic_caller_list = ["HaplotypeCaller", "vardict", "varscan2", "muse", "Mutect2"]
germ_caller_list = ["strelkamanta", "caveman"]

# CNV (off by default, same as the WES port — upstream mini-test has no CNV)
cnv_enabled = false
freec_ini_template = "scripts/config_exome.mini.ini"
freec_chr_len_file = "test/fixtures/cnv/freec_chrlen.txt"
freec_chr_files = "test/fixtures/cnv/freec_chr_fasta"
freec_sambamba = "sambamba"
sequenza_gc_wiggle = "test/fixtures/cnv/sequenza_gc.wig"
ascat_loci_prefix = "test/fixtures/cnv/ascat_loci/"
ascat_alleles_prefix = "test/fixtures/cnv/ascat_alleles/"
ascat_gc_file = "test/fixtures/cnv/ascat_gc.txt"
ascat_rt_file = ""
ascat_chroms = "21"
exomedepth_use_target_bed = true
exomedepth_bed = "test/fixtures/cnv/exomedepth_regions.bed"

# vcf2maf / VEP (upstream: config['softwares_params'][genome_version]['vcf2maf'])
ncbi_build = "GRCh38"
vep_data = "resources/ref_genome/hg38/vep"
vep_cache_version = "110"
vep_species = "homo_sapiens"
vep_cache_ready = false

# Java temp dir + report flag (shared with the WES port)
java_temp_dir = "/tmp"
run_report = true
annotate_beds_file = ""

# Engine-injected list of pair ids (used by expand_inputs gather rules)
pair_ids = ["mini"]

# ---------------------------------------------------------------------------
# Includes: the shared chain + WGS-specific modules. The WES caller modules
# (10_somatic_callers/20_germline) are NOT included — rules/91_wgs_callers
# carries the WGS-variant caller rules (upstream keeps them in the WGS tree).
# ---------------------------------------------------------------------------
[[include]]
path = "rules/00_common.oxoflow"

[[include]]
path = "rules/21_caveman.oxoflow"

[[include]]
path = "rules/30_vcf_norm.oxoflow"

[[include]]
path = "rules/40_vcf2maf.oxoflow"

[[include]]
path = "rules/50_merge.oxoflow"

[[include]]
path = "rules/60_report.oxoflow"

[[include]]
path = "rules/80_cnv.oxoflow"

[[include]]
path = "rules/90_wgs.oxoflow"

[[include]]
path = "rules/91_wgs_callers.oxoflow"

# ---------------------------------------------------------------------------
# Targets: the shared tail (vcf merge + VEP-gated MAF/report) plus the WGS
# SV merge point (upstream wrapper/wgs.smk call_sv stage targets the merged
# SV VCF; the port targets the per-caller SV outputs directly since the
# jasmine merge needs the upstream's custom jasminesv container).
# ---------------------------------------------------------------------------
[[rules]]
name = "all_vcf"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/vcf_norm/paired/{pair_id}/merge/{pair_id}.vcf", variables = { pair_id = "config.pair_ids" } }
]
output = ["{config.output_dir}/{config.genome_version}/results/all_vcf.done"]
shell = "touch {output[0]}"

[[rules]]
name = "all_sv"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_filter_bnd.vcf", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_germ.vcf", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/sv/paired/svaba/{pair_id}/{pair_id}.svaba.somatic.sv.vcf", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/vcf/paired/{pair_id}/Manta/results/variants/somaticSV.vcf.gz", variables = { pair_id = "config.pair_ids" } }
]
output = ["{config.output_dir}/{config.genome_version}/results/all_sv.done"]
shell = "touch {output[0]}"

[[rules]]
name = "all"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/maf/paired/{pair_id}/merge/{pair_id}.maf", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/maf_germline/paired/{pair_id}/merge/{pair_id}.maf", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/maf/paired/{pair_id}/anno/{pair_id}.maf", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/report/{pair_id}/{pair_id}_cancer_report.html", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/multiqc_report.html", variables = { pair_id = "config.pair_ids" } }
]
output = ["{config.output_dir}/{config.genome_version}/results/all.done"]
when = "config.vep_cache_ready"
shell = "touch {output[0]}"

[[rules]]
name = "all_cnv"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/cnv/paired/freec/{pair_id}/{pair_id}-T.bam_ratio.txt.png", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/cnv/paired/sequenza/{pair_id}/{pair_id}_segments.txt", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/cnv/paired/exomedepth/{pair_id}/{pair_id}_exomedepth.tsv", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/cnv/paired/ascat/{pair_id}/{pair_id}_purity.ploidy.tsv", variables = { pair_id = "config.pair_ids" } }
]
output = ["{config.output_dir}/{config.genome_version}/results/all_cnv.done"]
when = "config.cnv_enabled"
shell = "touch {output[0]}"
