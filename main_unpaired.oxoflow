# oxo-flow port of the clindet WES unpaired (tumor-only) mode
# (zyllifeworld/clindet @ 582a9131, workflow/WES/rules/rtm/unpaired + the
# unpaired tail of workflow/common/rules/merge_loop.smk).
#
# Upstream detects unpaired samples automatically from the sample sheet
# (rows without Normal fastqs) and runs mapping -> recal -> tumor-only
# callers -> merge_unpaired_vcf -> (call_mut: vcf2maf -> merge_unpaired_maf).
# The port ships the same path as this separate workflow driven by the
# tumor-only columns of samplesheet.csv.
#
# Upstream mini-test tumor_only_caller = [] (unpaired runs only map);
# upstream shipped default tumor_only_caller = [sage] — sage needs the
# upstream's custom hmftools container + multi-GB HMF resource tree, so the
# port defaults to the seven conda/container-portable callers instead
# (Mutect2, HaplotypeCaller, varscan2, strelka, vardict, lofreq, freebayes)
# and documents the sage/deepvariant/pindel exclusion in rules/70_unpaired.oxoflow.

[workflow]
name = "oxo-flow-clindet-unpaired"
version = "1.0.0"
description = "Clinical WES tumor-only pipeline ported from zyllifeworld/clindet (unpaired branch)"
author = "oxo-flow-community"
pairs_file = "samplesheet.csv"
format_version = "1.0"

# ---------------------------------------------------------------------------
# Project / genome (upstream: config['project'] + config['genome_version'])
# ---------------------------------------------------------------------------
[config]
output_dir = "mini_test"
genome_version = "hg38_chr21"

# Reads (upstream samplesheet Tumor_R1_file_path / Tumor_R2_file_path; the
# normal columns are ignored in this workflow)
tumor_fastq_r1 = "test/fixtures/reads/mini-T_R1.fq.gz"
tumor_fastq_r2 = "test/fixtures/reads/mini-T_R2.fq.gz"

# Resources (upstream: config['resources'][genome_version])
reference = "test/fixtures/refs/sequence/Homo_sapiens_assembly38_chr21.fasta"
reference_dict = "test/fixtures/refs/sequence/Homo_sapiens_assembly38_chr21.dict"
target_bed = "test/fixtures/bed/exome_target_hg38_chr21.bed"
# Upstream hg38_chr21 has no panel of normals (WES_PON: null) — leave empty
wes_pon = ""
mutect2_germline_vcf = "test/fixtures/refs/annotations/gnomAD.r2.1.1.GRCh38.PASS.AC.AF.only_chr21.vcf.gz"

# BQSR (upstream recal_BQSR, mini-test default False -> recal_link symlinks)
recal_bqsr = false
known_sites1 = "test/fixtures/refs/annotations/1000G_phase1.snps.high_confidence.hg38_chr21.vcf.gz"
known_sites2 = "test/fixtures/refs/annotations/Mills_and_1000G_gold_standard.indels.hg38_chr21.vcf.gz"

# Tumor-only caller list (upstream run_params.tumor_only_caller; see header)
unpaired_caller_list = ["Mutect2", "HaplotypeCaller", "varscan2", "strelka", "vardict", "lofreq", "freebayes"]

# vcf2maf / VEP (upstream: config['softwares_params'][genome_version]['vcf2maf'])
ncbi_build = "GRCh38"
vep_data = "resources/ref_genome/hg38/vep"
vep_cache_version = "110"
vep_species = "homo_sapiens"
# VEP needs a local cache at {vep_data}/{vep_species} (~10GB download; the
# fixture kit does not ship it). The vcf2maf rules and the MAF merge gate on
# this flag — set true once the cache is in place (upstream fails hard
# without it).
vep_cache_ready = false

# Java temp dir (upstream: config['params']['java']['temp_directory'])
java_temp_dir = "/tmp"

# Engine-injected list of pair ids (used by expand_inputs gather rules)
pair_ids = ["mini"]

# ---------------------------------------------------------------------------
# Includes
# ---------------------------------------------------------------------------
[[include]]
path = "rules/70_unpaired.oxoflow"

# ---------------------------------------------------------------------------
# Targets: upstream unpaired_res_list (mapping tail + per-caller VCFs) plus
# merge_unpaired_vcf (the unpaired vcf merge); the vcf2maf/MAF tail joins
# via the separate all_maf sink when vep_cache_ready = true.
# ---------------------------------------------------------------------------
[[rules]]
name = "all"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/recal/unpaired/{pair_id}-T.bam", variables = { pair_id = "config.pair_ids" } },
    { pattern = "{config.output_dir}/{config.genome_version}/results/vcf/unpaired/{pair_id}/merge/{pair_id}.vcf", variables = { pair_id = "config.pair_ids" } }
]
output = ["{config.output_dir}/{config.genome_version}/results/unpaired_all.done"]
shell = "touch {output[0]}"

[[rules]]
name = "all_maf"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/maf/unpaired/{pair_id}/merge/{pair_id}.maf", variables = { pair_id = "config.pair_ids" } }
]
output = ["{config.output_dir}/{config.genome_version}/results/unpaired_all_maf.done"]
when = "config.vep_cache_ready"
shell = "touch {output[0]}"
