# Somatic annotation rules

[[rules]]
name = "vep_annotate"
input = ["variants/merged/{pair_id}.somatic.merged.vcf.gz"]
output = ["annotated/{pair_id}.annotated.vcf.gz", "annotated/{pair_id}.annotated.maf"]
threads = 8
description = "Functional annotation with Ensembl VEP"
shell = """
mkdir -p annotated
vep --input_file {input[0]} \
    --output_file {output[0]} \
    --format vcf --vcf --compress_output bgzip \
    --force_overwrite --fork {threads} \
    --species homo_sapiens --assembly {config.genome_build} \
    --offline --dir_cache {config.vep_cache} \
    --everything

# Convert VCF to MAF for downstream analysis
perl scripts/vcf2maf.pl \
    --input-vcf {output[0]} \
    --output-maf {output[1]} \
    --tumor-id {experiment} \
    --normal-id {control} \
    --genome {config.genome_build} \
    --ref-fasta {config.reference}
"""
[rules.environment]
conda = "envs/clindet.yaml"
