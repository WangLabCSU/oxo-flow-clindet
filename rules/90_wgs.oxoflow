# WGS-specific rules, ported from upstream workflow/WGS/rules/mapping.smk
# (picard_collect_wgs, picard_flength_wgs) and workflow/WGS/rules/rtm/paired/
# SV/{delly,svaba}.smk. telomerecat is marked "departed" upstream — not
# ported.
#
# SV scope: delly (full 7-rule chain incl. germ) + svaba (core run) + Manta
# SV (the WGS Manta config rule in rules/91_wgs_callers.oxoflow emits
# somaticSV).
# gridss/BRASS/linx/igcaller/jasmine require the upstream's custom
# containers and Sanger/HMF reference trees (see README); the upstream
# sansa-annotation and svaba svanno rules gate on a sansa config that is
# absent from the mini test — not ported.

[workflow]
name = "wgs"

# --------------------------------------------------- WGS metrics ----
[[rules]]
name = "picard_collect_wgs_tumor"
input = {
    bam = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-T.bam",
    ref = "{config.reference}"
}
output = [ "{config.output_dir}/{config.genome_version}/results/stats/paired/wgs_metrics/{pair_id}-T.txt" ]
resources = { memory_mb = 1024 }
description = "gatk CollectWgsMetrics tumor (upstream WGS picard_collect_wgs; the GATK wrapper in the gatk4 image, same as the WES picard rules — the bare bioconda `picard` shim misparses the tool args)"
shell = """export _JAVA_OPTIONS=-Djava.io.tmpdir={config.java_temp_dir} && gatk CollectWgsMetrics -I {input.bam} -O {output[0]} -R {input.ref}"""
[rules.environment]
singularity = "https://depot.galaxyproject.org/singularity/gatk4%3A4.6.2.0--py310hdfd78af_1"

[[rules]]
name = "picard_collect_wgs_normal"
input = {
    bam = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-NC.bam",
    ref = "{config.reference}"
}
output = [ "{config.output_dir}/{config.genome_version}/results/stats/paired/wgs_metrics/{pair_id}-NC.txt" ]
resources = { memory_mb = 1024 }
description = "gatk CollectWgsMetrics normal (upstream WGS picard_collect_wgs)"
shell = """export _JAVA_OPTIONS=-Djava.io.tmpdir={config.java_temp_dir} && gatk CollectWgsMetrics -I {input.bam} -O {output[0]} -R {input.ref}"""
[rules.environment]
singularity = "https://depot.galaxyproject.org/singularity/gatk4%3A4.6.2.0--py310hdfd78af_1"

[[rules]]
name = "picard_flength_wgs_tumor"
input = {
    bam = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-T.bam",
    ref = "{config.reference}"
}
output = [
    "{config.output_dir}/{config.genome_version}/results/stats/paired/wgs_metrics/{pair_id}-T-fragment-length.txt",
    "{config.output_dir}/{config.genome_version}/results/stats/paired/wgs_metrics/{pair_id}-T-fragment-length.pdf"
]
resources = { memory_mb = 1024 }
description = "picard CollectInsertSizeMetrics tumor (upstream WGS picard_flength_wgs; -H is REQUIRED and needs R — the gatk4 image has no R, so the port runs the bioconda picard from envs/clindet.yaml which bundles R; live-verified)"
shell = """export _JAVA_OPTIONS=-Djava.io.tmpdir={config.java_temp_dir} && picard CollectInsertSizeMetrics -I {input.bam} -O {output[0]} -R {input.ref} -H {output[1]} -M 0.5"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "picard_flength_wgs_normal"
input = {
    bam = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-NC.bam",
    ref = "{config.reference}"
}
output = [
    "{config.output_dir}/{config.genome_version}/results/stats/paired/wgs_metrics/{pair_id}-NC-fragment-length.txt",
    "{config.output_dir}/{config.genome_version}/results/stats/paired/wgs_metrics/{pair_id}-NC-fragment-length.pdf"
]
resources = { memory_mb = 1024 }
description = "picard CollectInsertSizeMetrics normal (upstream WGS picard_flength_wgs; -H via the R-bundled bioconda picard, live-verified)"
shell = """export _JAVA_OPTIONS=-Djava.io.tmpdir={config.java_temp_dir} && picard CollectInsertSizeMetrics -I {input.bam} -O {output[0]} -R {input.ref} -H {output[1]} -M 0.5"""
[rules.environment]
conda = "envs/clindet.yaml"

# ------------------------------------------------------------ delly ----
[[rules]]
name = "SV_delly"
input = {
    Tum = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-T.bam",
    NC = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-NC.bam"
}
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}.bcf" ]
resources = { threads = 4 }
# Upstream runs `delly sr` inside its custom dellytools/delly container
# (resources/containers/delly_v2.3.1.sif); the port substitutes the
# portable depot bioconda delly 1.7.2, whose CLI renamed the `sr`
# subcommand to `call` (live: "Unrecognized command sr"). Flags are
# identical — upstream's own SV_delly_germ rule uses `delly call -q ... -s
# ...` — so this is a one-word translation, same semantics.
description = "delly call structural variant discovery (upstream WGS SV_delly, sr -> call for depot delly 1.7.2)"
shell = """delly call -g {config.reference} -q 20 -s 15 -o {output[0]} {input.Tum} {input.NC}"""
[rules.environment]
singularity = "https://depot.galaxyproject.org/singularity/delly%3A1.7.2--h4d20210_0"

[[rules]]
name = "SV_delly_sample_tsv"
input = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}.bcf" ]
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}.samples.tsv" ]
description = "write tumor/control sample map (upstream SV_delly_sample_tsv)"
shell = """bcftools query -l {input[0]} > {output[0]}.samples
awk 'NR==1{{print $1"\\ttumor"}}
     NR==2{{print $1"\\tcontrol"}}' \\
     {output[0]}.samples > {output[0]}
rm -f {output[0]}.samples"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "SV_delly_filter_somatic"
input = {
    bcf = "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}.bcf",
    samples = "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}.samples.tsv"
}
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_somatic.bcf" ]
description = "delly filter -p -f somatic -a 0.05 (upstream SV_delly_filter_somatic)"
shell = """delly filter -p -f somatic -a 0.05 -s {input.samples} -o {output[0]} {input.bcf}"""
[rules.environment]
singularity = "https://depot.galaxyproject.org/singularity/delly%3A1.7.2--h4d20210_0"

[[rules]]
name = "SV_delly_to_vcf"
input = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_somatic.bcf" ]
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_somatic.vcf" ]
description = "bcftools index + view PASS (upstream SV_delly_to_vcf)"
shell = """bcftools index -f {input[0]}
bcftools view -f PASS -O v -o {output[0]} {input[0]}"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "SV_delly_germ"
input = {
    NC = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-NC.bam"
}
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_germ.vcf" ]
resources = { threads = 4 }
description = "delly germline call on the normal bam (upstream SV_delly_germ)"
shell = """delly call -g {config.reference} {input.NC} -q 10 -s 15 -n > {output[0]}"""
[rules.environment]
singularity = "https://depot.galaxyproject.org/singularity/delly%3A1.7.2--h4d20210_0"

[[rules]]
name = "delly_filter"
input = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_somatic.vcf" ]
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_filter.vcf" ]
description = "bcftools filter PASS (upstream WGS delly_filter)"
shell = """bcftools filter -i 'FILTER="PASS"' {input[0]} > {output[0]}"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "delly2bnd"
input = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_filter.vcf" ]
output = [ "{config.output_dir}/{config.genome_version}/results/sv/paired/DELLY/{pair_id}/SV_delly_{pair_id}_filter_bnd.vcf" ]
description = "convert delly VCF to BND notation (upstream delly2bnd + delly2bnd.py)"
shell = """python3 scripts/delly2bnd.py -v {input[0]} -r {config.reference} -o {output[0]}"""
[rules.environment]
conda = "envs/clindet.yaml"

# ------------------------------------------------------------ svaba ----
[[rules]]
name = "SV_svaba"
input = {
    Tum = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-T.bam",
    NC = "{config.output_dir}/{config.genome_version}/results/recal/paired/{pair_id}-NC.bam",
    dbsnp_indel = "{config.dbsnp_indel}"
}
output = [
    "{config.output_dir}/{config.genome_version}/results/sv/paired/svaba/{pair_id}/{pair_id}.svaba.somatic.sv.vcf",
    "{config.output_dir}/{config.genome_version}/results/sv/paired/svaba/{pair_id}/{pair_id}.svaba.somatic.indel.vcf",
    "{config.output_dir}/{config.genome_version}/results/sv/paired/svaba/{pair_id}/{pair_id}.svaba.unfiltered.somatic.sv.vcf"
]
resources = { threads = 10 }
description = "svaba run tumor/normal (upstream WGS SV_svaba)"
shell = """svaba run -t {input.Tum} -n {input.NC} -p {threads} -D {input.dbsnp_indel} -a {config.output_dir}/{config.genome_version}/results/sv/paired/svaba/{pair_id}/{pair_id} -G {config.reference}"""
[rules.environment]
# upstream runs svaba in its custom svaba.sif; the port pins the bioconda
# 1.2.0 image (verified present on depot.galaxyproject.org)
singularity = "https://depot.galaxyproject.org/singularity/svaba%3A1.2.0--h69ac913_1"
