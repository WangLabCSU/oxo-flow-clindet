# CNV calling rules

[[rules]]
name = "amber"
input = ["aligned/{pair_id}_T.sorted.bam", "aligned/{pair_id}_N.sorted.bam"]
output = ["cnv/amber/{pair_id}/{pair_id}.amber.baf.pcf"]
threads = 10
shell = """
mkdir -p cnv/amber/{pair_id}
amber -tumor {experiment} -tumor_bam {input[0]} \
      -reference {control} -reference_bam {input[1]} \
      -target_regions_bed {Target_BED} \
      -output_dir cnv/amber/{pair_id} \
      -threads {threads} \
      -loci {config.amber_loci}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "cobalt"
input = ["aligned/{pair_id}_T.sorted.bam", "aligned/{pair_id}_N.sorted.bam"]
output = ["cnv/cobalt/{pair_id}/"]
threads = 10
shell = """
mkdir -p cnv/cobalt/{pair_id}
cobalt -tumor {experiment} -tumor_bam {input[0]} \
       -reference {control} -reference_bam {input[1]} \
       -output_dir cnv/cobalt/{pair_id} \
       -threads {threads} \
       -gc_profile {config.gc_profile}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "purple"
input = [
    "cnv/amber/{pair_id}/{pair_id}.amber.baf.pcf",
    "cnv/cobalt/{pair_id}/",
    "variants/merged/{pair_id}.somatic.merged.vcf.gz"
]
output = ["cnv/purple/{pair_id}/{pair_id}.purple.cnv.somatic.tsv"]
threads = 10
shell = """
mkdir -p cnv/purple/{pair_id}
purple -tumor {experiment} -reference {control} \
       -amber cnv/amber/{pair_id} \
       -cobalt cnv/cobalt/{pair_id} \
       -target_regions_bed {Target_BED} \
       -gc_profile {config.gc_profile} \
       -ref_genome {config.reference} \
       -ref_genome_version {config.genome_build} \
       -ensembl_data_dir {config.ensembl_data_dir} \
       -threads {threads} \
       -somatic_vcf {input[2]} \
       -output_dir cnv/purple/{pair_id}
"""
[rules.environment]
conda = "envs/clindet.yaml"
