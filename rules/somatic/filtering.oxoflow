# Somatic variant filtering and merging

[[rules]]
name = "filter_somatic_vcf"
input = ["variants/{pair_id}.{caller}.vcf.gz"]
output = ["variants/filtered/{pair_id}.{caller}.filtered.vcf.gz"]
shell = """
mkdir -p variants/filtered
Rscript scripts/vcf_filter_somtic.R \
    -i {input[0]} \
    -o {output[0]} \
    --tumor {experiment} \
    --normal {control} \
    --genome {config.genome_build}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "merge_somatic_vcfs"
input = [
    "variants/filtered/{pair_id}.mutect2.filtered.vcf.gz",
    "variants/filtered/{pair_id}.strelka2.filtered.vcf.gz",
    "variants/filtered/{pair_id}.vardict.filtered.vcf.gz"
]
output = ["variants/merged/{pair_id}.somatic.merged.vcf.gz"]
shell = """
mkdir -p variants/merged
python3 scripts/merge_caller_vcfs.py \
    --input {input} \
    --output {output[0]} \
    --pair {pair_id}
"""
[rules.environment]
conda = "envs/clindet.yaml"
