# Somatic variant callers

[[rules]]
name = "mutect2"
input = ["dedup/{pair_id}_T.dedup.bam", "dedup/{pair_id}_N.dedup.bam"]
output = ["variants/{pair_id}.mutect2.vcf.gz"]
threads = 4
description = "Somatic variant calling with Mutect2"
shell = """
mkdir -p variants
gatk Mutect2 -R {config.reference} \
    -I {input[0]} -tumor {experiment} \
    -I {input[1]} -normal {control} \
    -L {Target_BED} \
    -O {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "strelka2"
input = ["dedup/{pair_id}_T.dedup.bam", "dedup/{pair_id}_N.dedup.bam"]
output = ["variants/{pair_id}.strelka2.vcf.gz"]
threads = 8
description = "Somatic variant calling with Strelka2"
shell = """
mkdir -p variants/strelka2_{pair_id}
configureStrelkaSomaticWorkflow.py \
    --tumorBam {input[0]} \
    --normalBam {input[1]} \
    --referenceFasta {config.reference} \
    --runDir variants/strelka2_{pair_id}
variants/strelka2_{pair_id}/runWorkflow.py -m local -j {threads}
cp variants/strelka2_{pair_id}/results/variants/somatic.snvs.vcf.gz {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "vardict"
input = ["dedup/{pair_id}_T.dedup.bam", "dedup/{pair_id}_N.dedup.bam"]
output = ["variants/{pair_id}.vardict.vcf.gz"]
threads = 4
shell = """
vardict-java -G {config.reference} -f 0.01 -N {experiment} \
    -b "{input[0]}|{input[1]}" \
    -c 1 -S 2 -E 3 -g 4 {Target_BED} \
    | testsomatic.py | var2vcf_paired.pl -N "{experiment}|{control}" \
    | bgzip > {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "all_somatic"
input = ["variants/{pair_id}.mutect2.vcf.gz", "variants/{pair_id}.strelka2.vcf.gz", "variants/{pair_id}.vardict.vcf.gz"]
output = ["variants/{pair_id}.somatic_done"]
shell = "touch {output}"
