# Highly-accurate Somatic SNV rules ported from clindet-master

# --- Mutect2 Workflow ---
[[rules]]
name = "mutect2_pileup_tumor"
input = ["dedup/{pair_id}_T.sorted.bam"]
output = ["qc/pileup/{pair_id}_T_pileupsummaries.table"]
threads = 10
shell = """
export _JAVA_OPTIONS=-Djava.io.tmpdir={config.temp_dir}
gatk GetPileupSummaries -R {config.reference} \
    -I {input[0]} \
    -V {config.mutect2_vcf} \
    -L {Target_BED} \
    -O {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "mutect2_pileup_normal"
input = ["dedup/{pair_id}_N.sorted.bam"]
output = ["qc/pileup/{pair_id}_N_pileupsummaries.table"]
threads = 10
shell = """
export _JAVA_OPTIONS=-Djava.io.tmpdir={config.temp_dir}
gatk GetPileupSummaries -R {config.reference} \
    -I {input[0]} \
    -V {config.mutect2_vcf} \
    -L {Target_BED} \
    -O {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "mutect2_contamination"
input = ["qc/pileup/{pair_id}_T_pileupsummaries.table", "qc/pileup/{pair_id}_N_pileupsummaries.table"]
output = ["qc/contam/{pair_id}_segments.table", "qc/contam/{pair_id}_contamination.table"]
threads = 10
shell = """
export _JAVA_OPTIONS=-Djava.io.tmpdir={config.temp_dir}
gatk CalculateContamination \
    -I {input[0]} \
    -matched {input[1]} \
    -tumor-segmentation {output[0]} \
    -O {output[1]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "mutect2_call"
input = ["dedup/{pair_id}_T.sorted.bam", "dedup/{pair_id}_N.sorted.bam"]
output = ["variants/raw/{pair_id}.mutect2.vcf.gz"]
threads = 10
shell = """
export _JAVA_OPTIONS=-Djava.io.tmpdir={config.temp_dir}
gatk Mutect2 -R {config.reference} \
    --native-pair-hmm-threads {threads} \
    -I {input[0]} -I {input[1]} \
    -O {output[0]} \
    -normal {control} \
    -pon {config.pon} \
    --germline-resource {config.gnomad} \
    --intervals {Target_BED}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "mutect2_filter"
input = [
    "variants/raw/{pair_id}.mutect2.vcf.gz",
    "qc/contam/{pair_id}_contamination.table",
    "qc/contam/{pair_id}_segments.table"
]
output = ["variants/filtered/{pair_id}.mutect2.filtered.vcf.gz"]
threads = 10
shell = """
export _JAVA_OPTIONS=-Djava.io.tmpdir={config.temp_dir}
gatk FilterMutectCalls -R {config.reference} \
    -V {input[0]} \
    --contamination-table {input[1]} \
    --tumor-segmentation {input[2]} \
    --stats {input[0]}.stats \
    -O {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

# --- VarDict Workflow ---
[[rules]]
name = "vardict_call"
input = ["dedup/{pair_id}_T.sorted.bam", "dedup/{pair_id}_N.sorted.bam"]
output = ["variants/raw/{pair_id}.vardict.vcf.gz"]
threads = 10
shell = """
vardict-java -G {config.reference} -th {threads} \
    -f 0.01 -N '{experiment}|{control}' \
    -b "{input[0]}|{input[1]}" \
    -c 1 -S 2 -E 3 -g 4 {Target_BED} \
    | testsomatic.R | var2vcf_paired.pl -N '{experiment}|{control}' -f 0.01 \
    | bgzip > {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "vardict_filter"
input = ["variants/raw/{pair_id}.vardict.vcf.gz"]
output = ["variants/filtered/{pair_id}.vardict.filtered.vcf.gz"]
shell = """
bcftools view -i '(INFO/STATUS~"StrongSomatic" || INFO/STATUS~"LikelySomatic") && FILTER="PASS" && INFO/SSF <= 0.05' {input[0]} -Oz -o {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

# --- VarScan2 Workflow ---
[[rules]]
name = "varscan2_mpileup"
input = ["dedup/{pair_id}_T.sorted.bam", "dedup/{pair_id}_N.sorted.bam"]
output = ["qc/mpileup/{pair_id}_T.mp", "qc/mpileup/{pair_id}_N.mp"]
shell = """
samtools mpileup -q 1 -Q 1 -f {config.reference} -l {Target_BED} {input[0]} > {output[0]}
samtools mpileup -q 1 -Q 1 -f {config.reference} -l {Target_BED} {input[1]} > {output[1]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "varscan2_call"
input = ["qc/mpileup/{pair_id}_T.mp", "qc/mpileup/{pair_id}_N.mp"]
output = ["variants/raw/{pair_id}.varscan2.snp.vcf", "variants/raw/{pair_id}.varscan2.indel.vcf"]
shell = """
varscan somatic {input[1]} {input[0]} --output-snp {output[0]} --output-indel {output[1]} --output-vcf 1 --strand-filter 1
"""
[rules.environment]
conda = "envs/clindet.yaml"
