[[rules]]
name = "merge_unpaired_maf"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/maf/unpaired/{pair_id}/{caller}.vcf.maf", variables = { caller = "config.unpaired_caller_list", pair_id = "config.pair_ids" } }
]
output = [ "{config.output_dir}/{config.genome_version}/results/maf/unpaired/{pair_id}/merge/{pair_id}.maf" ]
description = "merge per-caller MAFs (upstream merge_unpaired_maf + merge_maf.R)"
when = "config.vep_cache_ready"
shell = """Rscript scripts/smk.R --script scripts/merge_maf.R --input maf1 {input} --param dir {config.output_dir}/{config.genome_version}/results/maf/unpaired/{pair_id} --output maf {output[0]}"""
[rules.environment]
conda = "envs/clindet.yaml"
