# Somatic clinical report rules

[[rules]]
name = "cancer_report"
input = [
    "qc/{pair_id}_T_fastp.json",
    "qc/{pair_id}_N_fastp.json",
    "annotated/{pair_id}.annotated.maf",
    "cnv/purple/{pair_id}/{pair_id}.purple.cnv.somatic.tsv"
]
output = ["reports/{pair_id}.cancer_report.html"]
shell = """
mkdir -p reports
Rscript scripts/rmd.R \
    --input {input[2]} \
    --output {output[0]} \
    --pair {pair_id} \
    --tumor {experiment} \
    --normal {control} \
    --cnv {input[3]} \
    --template scripts/cancer_report.Rmd
"""
[rules.environment]
conda = "envs/clindet.yaml"
