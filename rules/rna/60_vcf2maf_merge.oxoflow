# ------------------------------------------------------------ merged MAF ----
[[rules]]
name = "merge_rna_maf"
expand_inputs = [
    { pattern = "{config.output_dir}/{config.genome_version}/results/mut/maf/{pair_id}/{caller}.vcf.maf", variables = { caller = "config.rna_caller_list" } }
]
output = [ "{config.output_dir}/{config.genome_version}/results/mut/maf/{pair_id}/merge/{pair_id}.maf" ]
description = "merge per-caller RNA MAFs (upstream merge_rna_maf + merge_maf.R via the smk.R shim; sample barcode becomes {sample}_T)"
when = "config.run_type == 'rna' && (config.vep_cache_ready)"
shell = """Rscript scripts/smk.R --script scripts/merge_maf.R --input maf1 {input} --param dir {config.output_dir}/{config.genome_version}/results/mut/maf/{pair_id} --output maf {output[0]}"""
[rules.environment]
conda = "envs/clindet.yaml"
