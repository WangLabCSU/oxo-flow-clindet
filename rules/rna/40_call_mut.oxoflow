# ============================================================================
# DRAFT — RNA mutation-calling prep (upstream workflow/RNA/rules/call_mut_GATK.smk).
# NOT yet live-tested. Reviewed against the live-test cycle before finalizing.
#
# Upstream RNA/Snakefile hardcodes `redup = False`, which selects the link_bam
# (symlink) branch — the GATK MarkDuplicates branch (redup=True) never parses
# in the RNA workflow (and its -M {params.metrics} is undefined anyway).
#
# ---------------------------------------------------------------------------
# P1 — sentieon chain (upstream rules/call_mut_sentieon.smk), NOT PORTED:
#   mark_duplicates_score / mark_duplicates / link_bam / SplitNCigarReads /
#   sentieon_call / sentieon_anno_rna_edit.
#   Sentieon is a commercial product (licence required). Upstream config
#   hardcodes the cluster path softwares.sentieon.call =
#   /public/astra/bin/_sentieon/bin/sentieon, and the RNA Snakefile only
#   includes the sentieon rules when has_executable() finds that binary.
#   Port decision: GATK branch only, matching the port's DNA path.
#   (If ever ported: SplitNCigarReads becomes `sentieon driver --algo
#   RNASplitReadsAtJunction --reassign_mapq 255:60`; sentieon_anno_rna_edit
#   needs config.rna_edit_vcf, empty in the upstream test config.)
#
# redup=True MarkDuplicates branch — NOT PORTED: never active upstream;
# an equivalent GATK MarkDuplicates rule already exists in the DNA port
# (rules/00_common.oxoflow) if it is ever needed.
# ============================================================================

[workflow]
name = "rna_call_mut"

[[rules]]
name = "link_bam"
input = {
    bam = "{config.output_dir}/{config.genome_version}/results/mut/STAR/{pair_id}/{pair_id}.sorted.bam",
    bai = "{config.output_dir}/{config.genome_version}/results/mut/STAR/{pair_id}/{pair_id}.sorted.bam.bai"
}
output = {
    bam = "{config.output_dir}/{config.genome_version}/results/mut/dedup/{pair_id}.rmdep.bam",
    bai = "{config.output_dir}/{config.genome_version}/results/mut/dedup/{pair_id}.rmdep.bai"
}
resources = { threads = 1 }
description = "symlink STAR-mut BAM as the dedup BAM (upstream link_bam, redup=False branch)"
shell = """ln -s $(realpath {input.bam}) {output.bam}
ln -s $(realpath {input.bai}) {output.bai}"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "SplitNCigarReads"
input = {
    bam = "{config.output_dir}/{config.genome_version}/results/mut/dedup/{pair_id}.rmdep.bam",
    ref = "{config.reference}"
}
output = [ "{config.output_dir}/{config.genome_version}/results/mut/dedup/{pair_id}.split.bam" ]
resources = { threads = 10 }
description = "GATK SplitNCigarReads for RNA (upstream SplitNCigarReads)"
shell = """export _JAVA_OPTIONS=-Djava.io.tmpdir={config.java_temp_dir} && gatk SplitNCigarReads -R {input.ref} -I {input.bam} -O {output[0]}"""
[rules.environment]
singularity = "https://depot.galaxyproject.org/singularity/gatk4%3A4.6.2.0--py310hdfd78af_1"
