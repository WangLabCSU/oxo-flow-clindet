# clindet.oxoflow - Ported from zyllifeworld/clindet
# A clinical variant detection pipeline for cancer genomics.

[workflow]
name = "clindet"
version = "1.0.0"
description = "Comprehensive clinical variant detection pipeline"
author = "oxo-flow clindet port"
pairs_file = "samplesheet.csv"

[config]
# Reference genome and resource files
reference = "mini_test_data/dna/data/hg38_chr21.fa"
dbsnp = "mini_test_data/dna/data/dbsnp_146.hg38.vcf.gz"
known_indels = "mini_test_data/dna/data/Mills_and_1000G.indels.hg38.vcf.gz"

[defaults]
threads = 4
memory = "8G"

# --- RULES ---

# 1. Preprocessing: FastP QC & Trimming
[[rules]]
name = "fastp_tumor"
input = ["{Tumor_R1}", "{Tumor_R2}"]
output = ["qc/{pair_id}_T_fastp.json", "trimmed/{pair_id}_T_R1.fq.gz", "trimmed/{pair_id}_T_R2.fq.gz"]
threads = 8
description = "Quality control and trimming for tumor sample"
shell = """
mkdir -p trimmed qc
fastp -i {input[0]} -I {input[1]} \
      -o {output[1]} -O {output[2]} \
      --json {output[0]} --thread {threads}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "fastp_normal"
input = ["{Normal_R1}", "{Normal_R2}"]
output = ["qc/{pair_id}_N_fastp.json", "trimmed/{pair_id}_N_R1.fq.gz", "trimmed/{pair_id}_N_R2.fq.gz"]
threads = 8
description = "Quality control and trimming for normal sample"
shell = """
mkdir -p trimmed qc
fastp -i {input[0]} -I {input[1]} \
      -o {output[1]} -O {output[2]} \
      --json {output[0]} --thread {threads}
"""
[rules.environment]
conda = "envs/clindet.yaml"

# 2. Alignment: BWA-MEM
[[rules]]
name = "bwa_align_tumor"
input = ["trimmed/{pair_id}_T_R1.fq.gz", "trimmed/{pair_id}_T_R2.fq.gz"]
output = ["aligned/{pair_id}_T.sorted.bam"]
threads = 16
description = "Alignment for tumor sample"
shell = """
mkdir -p aligned
bwa mem -t {threads} -R '@RG\\tID:{experiment}\\tSM:{experiment}\\tPL:ILLUMINA' \
    {config.reference} {input[0]} {input[1]} \
    | samtools sort -@ 4 -o {output[0]}
samtools index {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "bwa_align_normal"
input = ["trimmed/{pair_id}_N_R1.fq.gz", "trimmed/{pair_id}_N_R2.fq.gz"]
output = ["aligned/{pair_id}_N.sorted.bam"]
threads = 16
description = "Alignment for normal sample"
shell = """
mkdir -p aligned
bwa mem -t {threads} -R '@RG\\tID:{control}\\tSM:{control}\\tPL:ILLUMINA' \
    {config.reference} {input[0]} {input[1]} \
    | samtools sort -@ 4 -o {output[0]}
samtools index {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

# 3. Post-Alignment: MarkDuplicates
[[rules]]
name = "mark_duplicates_tumor"
input = ["aligned/{pair_id}_T.sorted.bam"]
output = ["dedup/{pair_id}_T.dedup.bam", "dedup/{pair_id}_T.metrics.txt"]
shell = """
mkdir -p dedup
gatk MarkDuplicates -I {input[0]} -O {output[0]} -M {output[1]} --CREATE_INDEX true
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "mark_duplicates_normal"
input = ["aligned/{pair_id}_N.sorted.bam"]
output = ["dedup/{pair_id}_N.dedup.bam", "dedup/{pair_id}_N.metrics.txt"]
shell = """
mkdir -p dedup
gatk MarkDuplicates -I {input[0]} -O {output[0]} -M {output[1]} --CREATE_INDEX true
"""
[rules.environment]
conda = "envs/clindet.yaml"

# 4. Variant Calling: Mutect2 (Somatic)
[[rules]]
name = "mutect2"
input = ["dedup/{pair_id}_T.dedup.bam", "dedup/{pair_id}_N.dedup.bam"]
output = ["variants/{pair_id}.mutect2.vcf.gz"]
threads = 4
description = "Somatic variant calling with Mutect2"
shell = """
mkdir -p variants
gatk Mutect2 -R {config.reference} \
    -I {input[0]} -tumor {experiment} \
    -I {input[1]} -normal {control} \
    -L {Target_BED} \
    -O {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

# 5. Annotation: VEP (Placeholder)
[[rules]]
name = "vep_annotate"
input = ["variants/{pair_id}.mutect2.vcf.gz"]
output = ["annotated/{pair_id}.annotated.vcf.gz"]
shell = """
mkdir -p annotated
# Placeholder for VEP command
cp {input[0]} {output[0]} 
"""
[rules.environment]
conda = "envs/clindet.yaml"

[report]
template = "cancer_report"
format = ["html", "json"]
sections = ["summary", "qc", "alignment", "somatic_variants", "provenance"]
