# oxo-flow-clindet.oxoflow - Ported from zyllifeworld/clindet
# A complete clinical variant detection pipeline for cancer genomics.

[workflow]
name = "oxo-flow-clindet"
version = "1.0.0"
description = "Comprehensive clinical variant detection pipeline (WES/WGS/RNA)"
author = "oxo-flow clindet port"
pairs_file = "samplesheet.csv"
format_version = "1.0"

[config]
# Reference genome and resource files
reference = "mini_test_data/dna/data/hg38_chr21.fa"
genome_build = "hg38"
target_bed = "mini_test_data/dna/exome_target_hg38_chr21.bed"
dbsnp = "mini_test_data/dna/data/dbsnp_146.hg38.vcf.gz"
known_indels = "mini_test_data/dna/data/Mills_and_1000G.indels.hg38.vcf.gz"
gnomad = "resources/gnomad.vcf.gz"
pon = "resources/pon.vcf.gz"

# Software & Data Directories
vep_cache = "resources/vep_cache"
star_index = "mini_test_data/rna/star_index"
rsem_reference = "mini_test_data/rna/rsem_ref"
amber_loci = "resources/amber_loci.txt"
gc_profile = "resources/gc_profile.pcf"
ensembl_data_dir = "resources/ensembl"

[defaults]
threads = 4
memory = "8G"

# --- INCLUDES (Modular Sub-Workflows) ---
[[includes]]
path = "rules/common/qc.oxoflow"

[[includes]]
path = "rules/somatic/callers.oxoflow"

[[includes]]
path = "rules/somatic/extended_callers.oxoflow"

[[includes]]
path = "rules/somatic/filtering.oxoflow"

[[includes]]
path = "rules/somatic/cnv.oxoflow"

[[includes]]
path = "rules/sv/callers.oxoflow"

[[includes]]
path = "rules/unpaired/callers.oxoflow"

[[includes]]
path = "rules/annotation/vep.oxoflow"

[[includes]]
path = "rules/report/cancer.oxoflow"

[[includes]]
path = "rules/rna/expression.oxoflow"

[[includes]]
path = "rules/germline/gatk.oxoflow"

# --- CORE ALIGNMENT RULES ---

# Alignment: BWA-MEM for DNA
[[rules]]
name = "bwa_align_tumor"
input = ["{Tumor_R1}", "{Tumor_R2}"]
output = ["aligned/{pair_id}_T.sorted.bam"]
threads = 16
description = "BWA-MEM alignment for tumor sample"
shell = """
mkdir -p aligned
bwa mem -t {threads} -R '@RG\\tID:{experiment}\\tSM:{experiment}\\tPL:ILLUMINA' \
    {config.reference} {input[0]} {input[1]} \
    | samtools sort -@ 4 -o {output[0]}
samtools index {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "bwa_align_normal"
input = ["{Normal_R1}", "{Normal_R2}"]
output = ["aligned/{pair_id}_N.sorted.bam"]
threads = 16
description = "BWA-MEM alignment for normal sample"
shell = """
mkdir -p aligned
bwa mem -t {threads} -R '@RG\\tID:{control}\\tSM:{control}\\tPL:ILLUMINA' \
    {config.reference} {input[0]} {input[1]} \
    | samtools sort -@ 4 -o {output[0]}
samtools index {output[0]}
"""
[rules.environment]
conda = "envs/clindet.yaml"

# Post-Alignment: MarkDuplicates
[[rules]]
name = "mark_duplicates_tumor"
input = ["aligned/{pair_id}_T.sorted.bam"]
output = ["dedup/{pair_id}_T.dedup.bam", "dedup/{pair_id}_T.metrics.txt"]
shell = """
mkdir -p dedup
gatk MarkDuplicates -I {input[0]} -O {output[0]} -M {output[1]} --CREATE_INDEX true
"""
[rules.environment]
conda = "envs/clindet.yaml"

[[rules]]
name = "mark_duplicates_normal"
input = ["aligned/{pair_id}_N.sorted.bam"]
output = ["dedup/{pair_id}_N.dedup.bam", "dedup/{pair_id}_N.metrics.txt"]
shell = """
mkdir -p dedup
gatk MarkDuplicates -I {input[0]} -O {output[0]} -M {output[1]} --CREATE_INDEX true
"""
[rules.environment]
conda = "envs/clindet.yaml"

# --- TARGETS ---
# This rule defines the final desired outputs for a full run
[[rules]]
name = "all"
input = [
    "reports/{pair_id}.cancer_report.html",
    "germline/{experiment}.g.vcf.gz",
    "germline/{control}.g.vcf.gz",
    "sv/gridss/{pair_id}.vcf.gz",
    "variants/unpaired/{experiment}.mutect2.vcf.gz"
]
output = ["final_done_{pair_id}"]
shell = "touch {output}"
